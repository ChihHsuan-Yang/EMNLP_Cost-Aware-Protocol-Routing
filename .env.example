# ===========================================================================
# Copy to .env and fill in. NEVER COMMIT THE FILLED-IN FILE.
# ===========================================================================
# The runner reads these at call time. It records only the variable NAMES in
# run artifacts, never the values, and refuses to write a manifest or resolved
# config containing anything under a key named api_key / token / secret /
# authorization / base_url.

# --- inference endpoint (required unless using the mock provider) ----------
# Any OpenAI-compatible server. Include the /v1 suffix if your server uses one.
INFERENCE_BASE_URL=
INFERENCE_API_KEY=

# --- filesystem locations (required) ---------------------------------------
# Where you built the benchmark slices (see configs/datasets/*.yaml).
DATA_ROOT=
# Where run directories should be created.
OUTPUT_ROOT=

# --- optional, only if you serve the models yourself ------------------------
MODEL_CACHE_DIR=
HF_HOME=

# ---------------------------------------------------------------------------
# A zero-cost end-to-end run needs NONE of the above except DATA_ROOT:
#   python run_protocol.py \
#     --dataset-config  configs/datasets/omnimath.yaml \
#     --model-config    configs/models/gpt_oss_120b.yaml \
#     --protocol-config configs/protocols/per.yaml \
#     --provider-config configs/providers/mock.yaml \
#     --output-dir      runs/smoke --limit 5
# and --dry-run needs nothing at all.
